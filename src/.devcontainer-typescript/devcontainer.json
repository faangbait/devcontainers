{
    "name": "ubi-typescript",
    "build": {
        "dockerfile": "../.devcontainer/Containerfile",
        "context": "../.devcontainer",
        "target": "typescript"
    },
    "containerEnv": {
        "NPM_CONFIG_CACHE": "/opt/devcontainer-cache/npm"
    },
    "features": {},
    "customizations": {
        "vscode": {
            "extensions": [
                "yoavbls.pretty-ts-errors"
            ],
            "settings": {
                "[typescript]": {
                    "editor.defaultFormatter": "vscode.typescript-language-features"
                }
            }
        }
    },
    "mounts": [
        "source=devcontainer-cache-npm,target=/opt/devcontainer-cache/npm,type=volume",
        "source=devcontainer-cache-pnpm,target=/opt/devcontainer-cache/pnpm,type=volume"
    ]
}
