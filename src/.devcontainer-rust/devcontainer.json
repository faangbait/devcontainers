{
    "name": "ubi-rust",
    "build": {
        "dockerfile": "../.devcontainer/Containerfile",
        "context": "../.devcontainer",
        "target": "rust"
    },
    "containerEnv": {},
    "features": {},
    "customizations": {
        "vscode": {
            "extensions": [
                "vadimcn.vscode-lldb"
            ],
            "settings": {
                "rust-analyzer.runnables.test.overrideCommand": [
                    "cargo",
                    "nextest",
                    "run",
                    "--package",
                    "${package}",
                    "--release",
                    "--",
                    "${test_name}",
                    "${exact}",
                    "--nocapture",
                    "--include-ignored"
                ],
                "rust-analyzer.testExplorer": true,
                "[rust]": {
                    "editor.defaultFormatter": "rust-lang.rust-analyzer"
                }
            }
        }
    },
    "mounts": [
        "source=devcontainer-cache-cargo-registry,target=/usr/local/cargo/registry,type=volume",
        "source=devcontainer-cache-cargo-git,target=/usr/local/cargo/git,type=volume",
        "source=devcontainer-cache-cargo-target-${localWorkspaceFolderBasename},target=${containerWorkspaceFolder}/target,type=volume"
    ]
}
