{
    "name": "ubi-base",
    "build": {
        "dockerfile": "./Containerfile",
        "context": ".",
        "target": "base"
    },
    "containerEnv": {
        "PROJECT_ROOT": "${containerWorkspaceFolder}"
        // "SSM_HOSTS": "web=web-production|worker=worker-production|db=database-primary"
    },
    "features": {
        // 2.7.1 adds an unguarded `iptables` install, and UBI 10 ships no iptables
        // package, so the feature fails on every image. Unpin once upstream guards it.
        // see devcontainers/features issue #1776
        "ghcr.io/devcontainers/features/common-utils:2.7.0": {
            "installZsh": true,
            "username": "vscode",
            "upgradePackages": true
        },
        "ghcr.io/faangbait/dnf-features/aws-cli:1.1.0": {}
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "EditorConfig.EditorConfig",
                "timonwong.shellcheck",
                "ms-vscode.makefile-tools",
                "chrmarti.regex",
                "donjayamanne.githistory",
                "asispts.neo-git-graph",
                "waderyan.gitblame",
                "mk12.better-git-line-blame",
                "vivaxy.vscode-conventional-commits"
            ],
            "settings": {
                "workbench.secondarySideBar.defaultVisibility": "visibleInWorkspace",
                "telemetry.feedback.enabled": false
            },
            "mcp": {
                "servers": {
                    "smart-tree": {
                        "args": [
                            "--mcp"
                        ],
                        "command": "st",
                        "type": "stdio"
                    }
                }
            }
        }
    },
    "mounts": [
        "source=portable-shell-env,target=/etc/shell-env.d,type=volume"
    ],
    "remoteUser": "vscode",
    "postCreateCommand": "devcontainer-post-create",
    "postAttachCommand": "devcontainer-post-attach"
}
