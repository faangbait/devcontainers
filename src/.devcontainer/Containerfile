# syntax=docker/dockerfile:1
### CODENAME: SOL

ARG UBI_MINIMAL=registry.access.redhat.com/ubi10/ubi-minimal:latest

# =============================================================================
# INGREDIENTS
#
# Each payload is built independently. Published images never inherit from an
# ingredient; they only COPY its finished filesystem into the common runtime.
# =============================================================================

FROM scratch AS ripgrep-payload
ADD --unpack=true https://github.com/BurntSushi/ripgrep/releases/download/15.2.0/ripgrep-15.2.0-x86_64-unknown-linux-musl.tar.gz /

FROM scratch AS userland-payload

WORKDIR /usr/local/bin

ADD --chmod=0755 https://github.com/mikefarah/yq/releases/latest/download/yq_linux_amd64 ./yq
COPY --from=ripgrep-payload --chmod=0755 /ripgrep-*/rg ./rg
COPY --link --chmod=0755 bin/aws-profile-for-any-shell ./aws-profile-for-any-shell
COPY --link --chmod=0755 bin/devcontainer-post-create ./devcontainer-post-create
COPY --link --chmod=0755 bin/devcontainer-post-attach ./devcontainer-post-attach
COPY --link --chmod=0755 bin/ssm ./ssm

WORKDIR /etc
COPY --link etc/AGENTS.md ./claude-code/CLAUDE.md
COPY --link etc/context-mode.json ./context-mode.json
COPY --link etc/devcontainer-aliases.sh ./profile.d/devcontainer-aliases.sh

# -----------------------------------------------------------------------------
# Stable language floor
#
# Node/npm and lightweight Python are universal runtime capabilities. They are
# deliberately installed before the frequently edited core-components list so
# adding an OS utility never invalidates them or any sibling payload build.
# -----------------------------------------------------------------------------
FROM ${UBI_MINIMAL} AS base-dev-tools

LABEL maintainer="S Smith <root@madeof.glass>"
ENV container=oci-env
ENV LANG=C.UTF-8

RUN --mount=type=cache,id=ubi10-microdnf-amd64,target=/var/cache/yum,sharing=locked \
    microdnf install -y --releasever 10 --setopt=install_weak_deps=0 --setopt=keepcache=1 --nodocs \
    nodejs24 nodejs24-npm python3.14 python3.14-pip

RUN ln -sf /usr/bin/python3.14 /usr/local/bin/python && \
    ln -sf /usr/bin/node-24 /usr/local/bin/node && \
    ln -sf /usr/bin/npm-24 /usr/local/bin/npm && \
    ln -sf /usr/bin/npx-24 /usr/local/bin/npx

# -----------------------------------------------------------------------------
# Agent payload
#
# Each volatile agent acquisition is its own cache boundary. The final
# agents-payload stage only gathers their resolved binaries and pipx tree.
# -----------------------------------------------------------------------------
FROM base-dev-tools AS base-agent-env

RUN --mount=type=cache,id=ubi10-microdnf-amd64,target=/var/cache/yum,sharing=locked \
    microdnf install -y --releasever 10 --setopt=install_weak_deps=0 --setopt=keepcache=1 --nodocs \
    bash ca-certificates crontabs gzip shadow-utils tar unzip

ENV HOME=/mnt/agents-home
ENV NPM_CONFIG_PREFIX=/mnt/agents-npm
ENV CODEX_NON_INTERACTIVE=1

RUN useradd -m -d "$HOME" -s /bin/bash -u 10000 builder && \
    mkdir -p /mnt/init /mnt/payload "$NPM_CONFIG_PREFIX" && \
    chown -R builder:builder "$HOME" /mnt/init /mnt/payload "$NPM_CONFIG_PREFIX"

USER builder
WORKDIR /mnt/init

FROM base-agent-env AS smart-tree-payload
ADD --chown=builder:builder --chmod=0755 https://raw.githubusercontent.com/8b-is/smart-tree/main/scripts/install.sh ./install
RUN PATH=/mnt/payload:$PATH INSTALL_DIR=/mnt/payload ./install && chmod +x /mnt/payload/*

FROM base-agent-env AS codex-payload
ADD --chown=builder:builder --chmod=0755 https://chatgpt.com/codex/install.sh ./install
RUN --mount=type=cache,id=agents-home-cache,target=/mnt/agents-home/.cache,uid=10000,gid=10000 \
    CODEX_INSTALL_DIR=/mnt/payload ./install && \
    rm -f /mnt/payload/codex && \
    cp -L "$HOME"/.codex/packages/standalone/current/bin/codex /mnt/payload/codex && \
    cp -L "$HOME"/.codex/packages/standalone/current/bin/codex-code-mode-host /mnt/payload/codex-code-mode-host && \
    /mnt/payload/codex --version

FROM base-agent-env AS grok-payload
ADD --chown=builder:builder --chmod=0755 https://x.ai/cli/install.sh ./install
RUN GROK_BIN_DIR=/mnt/payload ./install && \
    /mnt/payload/grok --version

FROM base-agent-env AS claude-payload
RUN --mount=type=cache,id=agents-npm,target=/mnt/agents-home/.npm,uid=10000,gid=10000 \
    npm install -g @anthropic-ai/claude-code && \
    cp -L "$NPM_CONFIG_PREFIX/bin/claude" /mnt/payload/claude && \
    /mnt/payload/claude --version

FROM base-agent-env AS opencode-payload
RUN --mount=type=cache,id=agents-npm,target=/mnt/agents-home/.npm,uid=10000,gid=10000 \
    npm install -g opencode-ai && \
    cp -L "$NPM_CONFIG_PREFIX/bin/opencode" /mnt/payload/opencode && \
    /mnt/payload/opencode --version

FROM base-agent-env AS bun-payload
RUN --mount=type=cache,id=agents-npm,target=/mnt/agents-home/.npm,uid=10000,gid=10000 \
    npm install -g bun && \
    cp -L "$NPM_CONFIG_PREFIX/bin/bun" /mnt/payload/bun && \
    /mnt/payload/bun --version

FROM scratch AS rtk-payload
ADD --unpack https://github.com/rtk-ai/rtk/releases/download/v0.43.0/rtk-x86_64-unknown-linux-musl.tar.gz /

# -----------------------------------------------------------------------------
# Language and framework payloads. These are siblings of runtime, not children
# of it, so edits to core OS packages cannot trigger toolchain recompilation.
# -----------------------------------------------------------------------------
FROM base-dev-tools AS pipx-payload
ENV PYTHONPATH=/opt/agents/lib/python3.14/site-packages
ENV PIP_ROOT_USER_ACTION=ignore
RUN --mount=type=cache,id=root-pip,target=/root/.cache/pip \
    python3.14 -m pip install --prefix=/opt/agents pipx && \
    chmod -R a+rX /opt/agents && \
    /opt/agents/bin/pipx --version

FROM base-dev-tools AS uv-payload
RUN --mount=type=cache,id=ubi10-microdnf-amd64,target=/var/cache/yum,sharing=locked \
    microdnf install -y --releasever 10 --setopt=install_weak_deps=0 --setopt=keepcache=1 --nodocs gzip tar
RUN mkdir -p /opt/uv/bin && \
    curl -LsSf https://astral.sh/uv/install.sh | env UV_UNMANAGED_INSTALL=/opt/uv/bin sh && \
    /opt/uv/bin/uv --version

FROM base-dev-tools AS sass-payload
ENV NPM_CONFIG_PREFIX=/opt/sass
ENV PATH=/opt/sass/bin:$PATH
RUN --mount=type=cache,id=root-npm,target=/root/.npm \
    npm install -g sass && sass --version

FROM base-dev-tools AS typescript-payload
ENV NPM_CONFIG_PREFIX=/opt/typescript
ENV PATH=/opt/typescript/bin:$PATH
RUN --mount=type=cache,id=root-npm,target=/root/.npm \
    npm install -g typescript tsx eslint && \
    tsc --version && tsx --version && eslint --version

FROM base-dev-tools AS rust-payload

RUN --mount=type=cache,id=ubi10-microdnf-amd64,target=/var/cache/yum,sharing=locked \
    microdnf install -y --releasever 10 --setopt=install_weak_deps=0 --setopt=keepcache=1 --nodocs \
    ca-certificates gcc git-core make openssl-devel pkgconf-pkg-config

ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo
ENV PATH=/usr/local/cargo/bin:$PATH

ADD --chmod=0755 https://static.rust-lang.org/rustup/dist/x86_64-unknown-linux-gnu/rustup-init /tmp/rustup-init

RUN /tmp/rustup-init -y --no-modify-path --profile minimal && \
    rm /tmp/rustup-init && \
    chmod -R a+rwX "$RUSTUP_HOME" "$CARGO_HOME"

RUN --mount=type=cache,id=cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=cargo-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=cargo-target-stable-amd64,target=/tmp/cargo-target \
    CARGO_TARGET_DIR=/tmp/cargo-target cargo install --locked cargo-nextest && \
    chmod a+rwX "$CARGO_HOME/bin/cargo-nextest"

FROM base-dev-tools AS golang-payload

RUN --mount=type=cache,id=ubi10-microdnf-amd64,target=/var/cache/yum,sharing=locked \
    microdnf install -y --releasever 10 --setopt=install_weak_deps=0 --setopt=keepcache=1 --nodocs \
    ca-certificates gcc git-core

ENV GOROOT=/usr/local/go
ENV GOPATH=/usr/local/gopath
ENV PATH=/usr/local/go/bin:/usr/local/gopath/bin:$PATH

ADD --unpack https://go.dev/dl/go1.25.5.linux-amd64.tar.gz /usr/local/

RUN --mount=type=cache,id=go-mod-amd64,target=/usr/local/gopath/pkg/mod \
    --mount=type=cache,id=go-build-amd64,target=/root/.cache/go-build \
    <<-EOT
set -e
mkdir -p "$GOPATH/bin"
chmod a+rwx "$GOPATH" "$GOPATH/bin"
go install golang.org/x/tools/gopls@latest
go install github.com/go-delve/delve/cmd/dlv@latest
EOT

# -----------------------------------------------------------------------------
# Payload assembly. Fan-in stages come after their independent leaf recipes so
# the file reads in dependency order.
# -----------------------------------------------------------------------------
FROM scratch AS agents-payload
COPY --from=pipx-payload /opt/agents/ /opt/agents/
COPY --from=rtk-payload /rtk /opt/agents/bin/rtk
COPY --from=smart-tree-payload /mnt/payload/ /opt/agents/bin/
COPY --from=codex-payload /mnt/payload/ /opt/agents/bin/
COPY --from=grok-payload /mnt/payload/ /opt/agents/bin/
COPY --from=claude-payload /mnt/payload/ /opt/agents/bin/
COPY --from=opencode-payload /mnt/payload/ /opt/agents/bin/
COPY --from=bun-payload /mnt/payload/ /opt/agents/bin/

FROM scratch AS unit
WORKDIR /home/vscode
ADD MOCK_DATA.csv ./

FROM base-dev-tools AS runtime

# This is the intentionally easy-to-edit layer. Changing it does not invalidate
# base-dev-tools or any payload stage above.
### CORE COMPONENTS
RUN --mount=type=cache,id=ubi10-microdnf-amd64,target=/var/cache/yum,sharing=locked \
    microdnf install -y --releasever 10 --setopt=install_weak_deps=0 --setopt=keepcache=1 --nodocs \
    acl bash-completion bind-utils ca-certificates chkconfig crontabs \
    crypto-policies-scripts diffutils file findutils gawk gcc gdb-gdbserver \
    git-core gnupg2 grep gzip iproute iputils jq krb5-libs less libffi-devel libicu \
    libxml2-devel lsof make man-db nano ncurses ncurses-devel net-tools nmap-ncat \
    openssh-clients openssl-devel openssl-libs patch procps psmisc rsync sed shadow-utils \
    socat sqlite-devel strace sudo tar unzip vim-minimal wget which xz xz-devel \
    zip zlib zlib-devel zsh

COPY --from=userland-payload / /

# Let any user run `npm install -g` without sudo: rwx for everyone on the
# global install dirs, plus default ACLs so files/dirs created later inherit it.
# This runs after userland-payload because copying /usr/local/bin can replace
# directory metadata.
RUN mkdir -p /usr/local/lib/node_modules /usr/local/bin && \
    setfacl -R -m o::rwx /usr/local/lib/node_modules /usr/local/bin && \
    setfacl -R -d -m o::rwx /usr/local/lib/node_modules /usr/local/bin

CMD ["/bin/bash"]

# =============================================================================
# SANDWICHES
#
# Every published target starts from the same runtime bread and only adds the
# payloads it needs. There is no inheritance between published targets.
# =============================================================================
FROM runtime AS base

FROM runtime AS agents
COPY --link --from=agents-payload /opt/agents/ /opt/agents/
ENV PATH=/opt/agents/bin:$PATH
ENV PYTHONPATH=/opt/agents/lib/python3.14/site-packages

FROM runtime AS python
COPY --link --from=uv-payload /opt/uv/ /opt/uv/
COPY --link --from=agents-payload /opt/agents/ /opt/agents/
ENV PATH=/opt/agents/bin:/opt/uv/bin:$PATH
ENV PYTHONPATH=/opt/agents/lib/python3.14/site-packages

FROM runtime AS django
COPY --link --from=uv-payload /opt/uv/ /opt/uv/
COPY --link --from=sass-payload /opt/sass/ /opt/sass/
COPY --link --chmod=0755 bin/django-manage /etc/profile.d/django-manage.sh
COPY --link --from=agents-payload /opt/agents/ /opt/agents/
ENV PATH=/opt/agents/bin:/opt/uv/bin:/opt/sass/bin:$PATH
ENV PYTHONPATH=/opt/agents/lib/python3.14/site-packages

FROM runtime AS rust
COPY --link --from=rust-payload /usr/local/rustup/ /usr/local/rustup/
COPY --link --from=rust-payload /usr/local/cargo/ /usr/local/cargo/
COPY --link --from=agents-payload /opt/agents/ /opt/agents/
ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo
ENV PATH=/opt/agents/bin:/usr/local/cargo/bin:$PATH
ENV PYTHONPATH=/opt/agents/lib/python3.14/site-packages

FROM runtime AS typescript
COPY --link --from=typescript-payload /opt/typescript/ /opt/typescript/
COPY --link --from=agents-payload /opt/agents/ /opt/agents/
ENV PATH=/opt/agents/bin:/opt/typescript/bin:$PATH
ENV PYTHONPATH=/opt/agents/lib/python3.14/site-packages

FROM runtime AS devops
COPY --link --from=uv-payload /opt/uv/ /opt/uv/
COPY --link --from=sass-payload /opt/sass/ /opt/sass/
COPY --link --from=agents-payload /opt/agents/ /opt/agents/
RUN echo 'alias tf=terraform' > /etc/profile.d/tf-alias.sh
ENV PATH=/opt/agents/bin:/opt/uv/bin:/opt/sass/bin:$PATH
ENV PYTHONPATH=/opt/agents/lib/python3.14/site-packages

FROM runtime AS golang
COPY --link --from=golang-payload /usr/local/go/ /usr/local/go/
COPY --link --from=golang-payload /usr/local/gopath/ /usr/local/gopath/
COPY --link --from=agents-payload /opt/agents/ /opt/agents/
ENV GOROOT=/usr/local/go
ENV GOPATH=/usr/local/gopath
ENV PATH=/opt/agents/bin:/usr/local/go/bin:/usr/local/gopath/bin:$PATH
ENV PYTHONPATH=/opt/agents/lib/python3.14/site-packages
