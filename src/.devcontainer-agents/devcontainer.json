// The agent CLIs ship as Dev Container Features from
// ghcr.io/faangbait/dnf-features (see ADR006), not in this image. The agents
// target is runtime plus this layer, and every other variant inherits it for
// the shared agent state volume and the config-directory environment the
// agent features write into.
{
    "name": "ubi-agents",
    "build": {
        "dockerfile": "../.devcontainer/Containerfile",
        "context": "../.devcontainer",
        "target": "agents"
    },
    "containerEnv": {
        "CLAUDE_CONFIG_DIR": "/var/llms/claude",
        "CODEX_HOME": "/var/llms/codex",
        "OPENCODE_CONFIG_DIR": "/var/llms/opencode"
    },
    "features": {
        "ghcr.io/devcontainers/features/python:1": {
            "version": "3.14",
            "installTools": true,
            "toolsToInstall": ""
        }
    },
    "mounts": [
        "source=portable-agents,target=/var/llms,type=volume"
    ]
}
