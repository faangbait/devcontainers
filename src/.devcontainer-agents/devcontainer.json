{
    "name": "ubi-agents",
    "build": {
        "dockerfile": "../.devcontainer/Containerfile",
        "context": "../.devcontainer",
        "target": "agents"
    },
    "containerEnv": {
        "CLAUDE_CONFIG_DIR": "/var/llms/claude",
        "CODEX_HOME": "/var/llms/codex",
        "OPENCODE_CONFIG_DIR": "/var/llms/opencode"
    },
    "features": {
        "ghcr.io/devcontainers/features/python:1": {
            "version": "3.14",
            "installTools": true,
            "toolsToInstall": ""
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ankurmathur.opencode-provider-bridge"
            ],
            "settings": {},
            "mcp": {
                "servers": {
                    "context-mode": {
                        "command": "context-mode"
                    },
                    "smart-tree": {
                        "args": [
                            "--mcp"
                        ],
                        "command": "st",
                        "type": "stdio"
                    }
                }
            }
        }
    },
    "mounts": [
        "source=portable-agents,target=/var/llms,type=volume"
    ]
}
